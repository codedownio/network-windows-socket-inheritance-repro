cabal-version: 2.4
name:          repro
version:       0
executable repro
  main-is:          Main.hs
  build-depends:    base, bytestring, network, process
  if os(windows)
    ghc-options:    -with-rtsopts=--io-manager=native
  else
    build-depends:  unix
  default-language: Haskell2010
  ghc-options:      -threaded -rtsopts
